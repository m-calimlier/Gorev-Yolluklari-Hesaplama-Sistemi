<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <SolidColorBrush x:Key="Navy" Color="#0B1730"/><SolidColorBrush x:Key="Card" Color="#152643"/><SolidColorBrush x:Key="Gold" Color="#DBB65A"/>
 <Style x:Key="WorkspaceCard" TargetType="Border">
  <Setter Property="Background" Value="{StaticResource Card}"/>
  <Setter Property="BorderBrush" Value="#35546F"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="CornerRadius" Value="12"/>
  <Setter Property="Padding" Value="18"/>
  <Setter Property="Margin" Value="0,0,0,14"/>
 </Style>
 <Style x:Key="OverviewMetric" TargetType="Border" BasedOn="{StaticResource WorkspaceCard}">
  <Setter Property="Background" Value="#10213B"/>
  <Setter Property="Padding" Value="12,9"/>
  <Setter Property="Margin" Value="0,0,8,0"/>
 </Style>
 <Style x:Key="WorkspaceNavigationItem" TargetType="ListBoxItem">
  <Setter Property="DockPanel.Dock" Value="Top"/>
  <Setter Property="Padding" Value="10,11"/>
  <Setter Property="Margin" Value="0,0,0,4"/>
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="ListBoxItem">
     <Border x:Name="Tile" Background="Transparent" BorderBrush="Transparent"
             BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
       <Setter TargetName="Tile" Property="Background" Value="#243C5E"/>
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
       <Setter TargetName="Tile" Property="Background" Value="#243C5E"/>
       <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource Gold}"/>
      </Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True">
       <Setter TargetName="Tile" Property="BorderBrush" Value="#BCD4F3"/>
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
  <Style.Triggers>
   <DataTrigger Binding="{Binding}" Value="Kaynaklar">
    <Setter Property="DockPanel.Dock" Value="Bottom"/>
   </DataTrigger>
  </Style.Triggers>
 </Style>
 <Style x:Key="DutyTabs" TargetType="TabControl">
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="TabControl">
     <TabPanel IsItemsHost="True" KeyboardNavigation.TabNavigation="Once"/>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style x:Key="DutyTab" TargetType="TabItem">
  <Setter Property="Foreground" Value="#E8EFFA"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="Margin" Value="0,0,8,0"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="TabItem">
     <Border x:Name="TabTile" Background="{StaticResource Card}" BorderBrush="#35546F" BorderThickness="1"
             CornerRadius="8" Padding="16,9">
      <ContentPresenter ContentSource="Header"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
       <Setter TargetName="TabTile" Property="Background" Value="#243C5E"/>
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
       <Setter TargetName="TabTile" Property="Background" Value="{StaticResource Gold}"/>
       <Setter Property="Foreground" Value="{StaticResource Navy}"/>
      </Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True">
       <Setter TargetName="TabTile" Property="BorderBrush" Value="#BCD4F3"/>
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
 <SolidColorBrush x:Key="InputSurface" Color="#102641"/>
 <SolidColorBrush x:Key="InputOutline" Color="#506D8A"/>
 <Style TargetType="Label">
  <Setter Property="Foreground" Value="#D3DFEF"/>
  <Setter Property="FontSize" Value="12"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="Padding" Value="0,9,0,4"/>
 </Style>
 <Style TargetType="TextBox">
  <Setter Property="Padding" Value="9,5"/>
  <Setter Property="Margin" Value="0,0,8,5"/>
  <Setter Property="MinHeight" Value="35"/>
  <Setter Property="Background" Value="{StaticResource InputSurface}"/>
  <Setter Property="Foreground" Value="#F0F6FC"/>
  <Setter Property="CaretBrush" Value="#F0F6FC"/>
  <Setter Property="BorderBrush" Value="{StaticResource InputOutline}"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="TextBox">
     <Border x:Name="FieldFrame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
             BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
      <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsKeyboardFocused" Value="True">
       <Setter TargetName="FieldFrame" Property="BorderBrush" Value="{StaticResource Gold}"/>
      </Trigger>
      <Trigger Property="Validation.HasError" Value="True">
       <Setter TargetName="FieldFrame" Property="BorderBrush" Value="#FF938B"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
       <Setter TargetName="FieldFrame" Property="Opacity" Value="0.48"/>
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style TargetType="ComboBox">
  <Setter Property="Padding" Value="9,5"/>
  <Setter Property="Margin" Value="0,0,8,5"/>
  <Setter Property="MinHeight" Value="35"/>
  <Setter Property="Background" Value="{StaticResource InputSurface}"/>
  <Setter Property="Foreground" Value="#F0F6FC"/>
  <Setter Property="BorderBrush" Value="{StaticResource InputOutline}"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="ComboBox">
     <Grid>
      <Border x:Name="FieldFrame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"/>
      <ToggleButton Focusable="False" ClickMode="Press"
                    IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
       <ToggleButton.Template>
        <ControlTemplate TargetType="ToggleButton">
         <Border Background="Transparent" Padding="10,0">
          <Path Data="M 0,0 L 4,4 L 8,0" Stroke="#DBB65A" StrokeThickness="1.6"
                HorizontalAlignment="Right" VerticalAlignment="Center"/>
         </Border>
        </ControlTemplate>
       </ToggleButton.Template>
      </ToggleButton>
      <ContentPresenter Margin="10,0,27,0" VerticalAlignment="Center" IsHitTestVisible="False"
                        Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                        ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
      <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
             PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
       <Border Margin="0,3,0,0" Background="{StaticResource InputSurface}" BorderBrush="{StaticResource InputOutline}"
               BorderThickness="1" CornerRadius="6" Padding="3"
               MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
        <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" CanContentScroll="True">
         <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
        </ScrollViewer>
       </Border>
      </Popup>
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
       <Setter TargetName="FieldFrame" Property="BorderBrush" Value="{StaticResource Gold}"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
       <Setter Property="Opacity" Value="0.48"/>
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
  <Setter Property="ItemContainerStyle">
   <Setter.Value>
    <Style TargetType="ComboBoxItem">
     <Setter Property="Padding" Value="8,6"/>
     <Setter Property="Foreground" Value="#F0F6FC"/>
     <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
     <Setter Property="Template">
      <Setter.Value>
       <ControlTemplate TargetType="ComboBoxItem">
        <Border x:Name="OptionFrame" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4">
         <ContentPresenter/>
        </Border>
        <ControlTemplate.Triggers>
         <Trigger Property="IsHighlighted" Value="True">
          <Setter TargetName="OptionFrame" Property="Background" Value="#315677"/>
         </Trigger>
         <Trigger Property="IsSelected" Value="True">
          <Setter Property="Foreground" Value="#FFE3A2"/>
         </Trigger>
        </ControlTemplate.Triggers>
       </ControlTemplate>
      </Setter.Value>
     </Setter>
    </Style>
   </Setter.Value>
  </Setter>
 </Style>
 <Style TargetType="Button"><Setter Property="Background" Value="{StaticResource Gold}"/><Setter Property="Foreground" Value="#10213B"/><Setter Property="Padding" Value="13,8"/><Setter Property="Margin" Value="0,4,8,4"/><Setter Property="MinHeight" Value="36"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/></Style>
 <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#EEF3FA"/><Setter Property="Margin" Value="0,8,12,8"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
 <Style TargetType="GroupBox"><Setter Property="Foreground" Value="{StaticResource Gold}"/><Setter Property="Margin" Value="0,8,0,10"/><Setter Property="Padding" Value="12"/><Setter Property="BorderBrush" Value="#3E5272"/></Style>
 <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="Background" Value="#F2F5FA"/><Setter Property="Foreground" Value="#10213B"/><Setter Property="RowBackground" Value="White"/><Setter Property="AlternatingRowBackground" Value="#E8EEF6"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="RowHeight" Value="34"/><Setter Property="ColumnHeaderHeight" Value="38"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="SelectionUnit" Value="CellOrRowHeader"/><Setter Property="ClipboardCopyMode" Value="IncludeHeader"/></Style>
 <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#243C5E"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="7"/></Style>
</ResourceDictionary>
