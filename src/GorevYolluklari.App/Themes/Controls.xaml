<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <SolidColorBrush x:Key="Navy" Color="#0B1730"/><SolidColorBrush x:Key="Card" Color="#152643"/><SolidColorBrush x:Key="Gold" Color="#DBB65A"/>
 <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
 <Style TargetType="Label"><Setter Property="Foreground" Value="#CCD7E8"/><Setter Property="Padding" Value="0,10,0,4"/></Style>
 <Style TargetType="TextBox"><Setter Property="Padding" Value="8,7"/><Setter Property="Margin" Value="0,0,10,5"/><Setter Property="Background" Value="#F2F5FA"/><Setter Property="Foreground" Value="#10213B"/><Setter Property="MinHeight" Value="34"/></Style>
 <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,5"/><Setter Property="Margin" Value="0,0,10,5"/><Setter Property="MinHeight" Value="34"/><Setter Property="Foreground" Value="#10213B"/></Style>
 <Style TargetType="Button"><Setter Property="Background" Value="{StaticResource Gold}"/><Setter Property="Foreground" Value="#10213B"/><Setter Property="Padding" Value="13,8"/><Setter Property="Margin" Value="0,4,8,4"/><Setter Property="MinHeight" Value="36"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/></Style>
 <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#EEF3FA"/><Setter Property="Margin" Value="0,8,12,8"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
 <Style TargetType="GroupBox"><Setter Property="Foreground" Value="{StaticResource Gold}"/><Setter Property="Margin" Value="0,8,0,10"/><Setter Property="Padding" Value="12"/><Setter Property="BorderBrush" Value="#3E5272"/></Style>
 <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="Background" Value="#F2F5FA"/><Setter Property="Foreground" Value="#10213B"/><Setter Property="RowBackground" Value="White"/><Setter Property="AlternatingRowBackground" Value="#E8EEF6"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="RowHeight" Value="34"/><Setter Property="ColumnHeaderHeight" Value="38"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="SelectionUnit" Value="CellOrRowHeader"/><Setter Property="ClipboardCopyMode" Value="IncludeHeader"/></Style>
 <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#243C5E"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="7"/></Style>
</ResourceDictionary>
