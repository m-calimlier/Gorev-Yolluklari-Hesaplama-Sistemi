<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <!-- Görev Yollukları: Ek Ders Hakediş Sistemi (Oehs/Workspace/PaymentCards)
      tasarım sisteminden uyarlanan bağımsız WPF kaynakları.
      Hesap kuralları, veri tipleri, saklama ve PDF şablonları değiştirilmez. -->
 <SolidColorBrush x:Key="HakedisTextBrush" Color="#F0F6FC"/>
 <SolidColorBrush x:Key="HakedisMutedBrush" Color="#B9CDDF"/>
 <SolidColorBrush x:Key="HakedisTableBrush" Color="#09283F"/>
 <SolidColorBrush x:Key="HakedisGoldBrush" Color="#E8C778"/>
 <SolidColorBrush x:Key="HakedisLineBrush" Color="#466780"/>
 <LinearGradientBrush x:Key="HakedisInputBrush" StartPoint="0,0" EndPoint="0,1">
   <GradientStop Color="#264E69" Offset="0"/>
   <GradientStop Color="#12354D" Offset="1"/>
 </LinearGradientBrush>
 <LinearGradientBrush x:Key="HakedisPanelBrush" StartPoint="0,0" EndPoint="1,1">
   <GradientStop Color="#123952" Offset="0"/>
   <GradientStop Color="#0B2C44" Offset="0.58"/>
   <GradientStop Color="#071F33" Offset="1"/>
 </LinearGradientBrush>
 <LinearGradientBrush x:Key="HakedisPrimaryBrush" StartPoint="0,0" EndPoint="0,1">
   <GradientStop Color="#F5D995" Offset="0"/>
   <GradientStop Color="#DBB65A" Offset="1"/>
 </LinearGradientBrush>
 <Style x:Key="HakedisWorkspaceCard" TargetType="Border">
   <Setter Property="Background" Value="{StaticResource HakedisPanelBrush}"/>
   <Setter Property="BorderBrush" Value="{StaticResource HakedisLineBrush}"/>
   <Setter Property="BorderThickness" Value="1.2"/>
   <Setter Property="CornerRadius" Value="12"/>
   <Setter Property="Padding" Value="17"/>
   <Setter Property="Margin" Value="0,0,0,14"/>
   <Setter Property="VerticalAlignment" Value="Top"/>
   <Setter Property="SnapsToDevicePixels" Value="True"/>
 </Style>
 <Style x:Key="HakedisCardTitle" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{StaticResource HakedisGoldBrush}"/>
   <Setter Property="FontSize" Value="18"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="TextWrapping" Value="Wrap"/>
   <Setter Property="Margin" Value="0,0,0,10"/>
 </Style>
 <Style x:Key="HakedisCardSubtitle" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{StaticResource HakedisMutedBrush}"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="TextWrapping" Value="Wrap"/>
   <Setter Property="Margin" Value="0,0,0,12"/>
 </Style>
 <Style x:Key="HakedisFieldLabel" TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
   <Setter Property="Foreground" Value="#D5E4F1"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Padding" Value="0,9,0,4"/>
 </Style>
 <Style x:Key="HakedisFieldText" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
   <Setter Property="Background" Value="{StaticResource HakedisInputBrush}"/>
   <Setter Property="Foreground" Value="{StaticResource HakedisTextBrush}"/>
   <Setter Property="CaretBrush" Value="White"/>
   <Setter Property="SelectionBrush" Value="#4286B1"/>
   <Setter Property="BorderBrush" Value="#5A7B94"/>
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Padding" Value="9,6"/>
   <Setter Property="MinHeight" Value="38"/>
 </Style>
 <Style x:Key="HakedisFieldCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
   <Setter Property="Background" Value="{StaticResource HakedisInputBrush}"/>
   <Setter Property="Foreground" Value="{StaticResource HakedisTextBrush}"/>
   <Setter Property="BorderBrush" Value="#5A7B94"/>
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Padding" Value="9,6"/>
   <Setter Property="MinHeight" Value="38"/>
 </Style>
 <Style x:Key="HakedisPrimaryAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="{StaticResource HakedisPrimaryBrush}"/>
   <Setter Property="Foreground" Value="#09253F"/>
   <Setter Property="MinHeight" Value="39"/>
   <Setter Property="Padding" Value="14,8"/>
   <Setter Property="Template">
     <Setter.Value><ControlTemplate TargetType="Button">
       <Border x:Name="Face" Background="{TemplateBinding Background}"
               CornerRadius="8" BorderBrush="#CBA951" BorderThickness="1"
               Padding="{TemplateBinding Padding}">
         <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
       </Border>
       <ControlTemplate.Triggers>
         <Trigger Property="IsMouseOver" Value="True">
           <Setter TargetName="Face" Property="Opacity" Value="0.86"/>
         </Trigger>
         <Trigger Property="IsPressed" Value="True">
           <Setter TargetName="Face" Property="Opacity" Value="0.72"/>
         </Trigger>
         <Trigger Property="IsEnabled" Value="False">
           <Setter TargetName="Face" Property="Opacity" Value="0.45"/>
         </Trigger>
       </ControlTemplate.Triggers>
     </ControlTemplate></Setter.Value>
   </Setter>
 </Style>
 <Style x:Key="HakedisSecondaryAction" TargetType="Button" BasedOn="{StaticResource HakedisPrimaryAction}">
   <Setter Property="Background" Value="{StaticResource HakedisInputBrush}"/>
   <Setter Property="Foreground" Value="{StaticResource HakedisTextBrush}"/>
 </Style>
 <Style x:Key="HakedisInfoCard" TargetType="Border">
   <Setter Property="Background" Value="#102F49"/>
   <Setter Property="BorderBrush" Value="#456D87"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="9"/>
   <Setter Property="Padding" Value="11,9"/>
   <Setter Property="Margin" Value="0,2,0,12"/>
 </Style>
 <Style x:Key="HakedisMetricCard" TargetType="Border">
   <Setter Property="Background" Value="{StaticResource HakedisPanelBrush}"/>
   <Setter Property="BorderBrush" Value="#AD9054"/>
   <Setter Property="BorderThickness" Value="1.2"/>
   <Setter Property="CornerRadius" Value="11"/>
   <Setter Property="Padding" Value="14"/>
   <Setter Property="Margin" Value="0,4,0,12"/>
   <Setter Property="MinHeight" Value="82"/>
   <Setter Property="Effect"><Setter.Value>
     <DropShadowEffect Color="#BD9447" BlurRadius="10" ShadowDepth="2" Opacity="0.14"/>
   </Setter.Value></Setter>
 </Style>
 <Style x:Key="HakedisStatusBanner" TargetType="Border">
   <Setter Property="Background" Value="#09283F"/>
   <Setter Property="BorderBrush" Value="#466780"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="9"/>
   <Setter Property="Padding" Value="10,8"/>
 </Style>
 <!-- Ek Ders'in ModernDataGrid/hybrid-editor desenine uyarlama. -->
 <Style x:Key="HakedisDataGridRow" TargetType="DataGridRow">
   <Setter Property="Background" Value="#09283F"/>
   <Setter Property="Foreground" Value="#F0F6FC"/>
   <Style.Triggers>
     <Trigger Property="ItemsControl.AlternationIndex" Value="1">
       <Setter Property="Background" Value="#14374F"/>
     </Trigger>
     <Trigger Property="IsMouseOver" Value="True">
       <Setter Property="Background" Value="#27536C"/>
     </Trigger>
     <Trigger Property="IsSelected" Value="True">
       <Setter Property="Background" Value="#285778"/>
       <Setter Property="Foreground" Value="#FFFFFF"/>
     </Trigger>
   </Style.Triggers>
 </Style>
 <Style x:Key="HakedisDataGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
   <Setter Property="Background" Value="#09283F"/>
   <Setter Property="Foreground" Value="#F0F6FC"/>
   <Setter Property="RowBackground" Value="#09283F"/>
   <Setter Property="AlternatingRowBackground" Value="#14374F"/>
   <Setter Property="BorderBrush" Value="#466780"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="HorizontalGridLinesBrush" Value="#35566F"/>
   <Setter Property="VerticalGridLinesBrush" Value="#35566F"/>
   <Setter Property="RowStyle" Value="{StaticResource HakedisDataGridRow}"/>
   <Setter Property="AlternationCount" Value="2"/>
   <Setter Property="ColumnHeaderHeight" Value="38"/>
   <Setter Property="RowHeight" Value="34"/>
 </Style>
 <!-- Ek Ders'in çalışır koyu tarih ve takvim şablonu; isimler çakışmaması için ayrıldı. -->
 <Style x:Key="HakedisCalendarDay" TargetType="CalendarDayButton">
            <Setter Property="Foreground" Value="#F0F6FC"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="MinWidth" Value="30"/><Setter Property="MinHeight" Value="28"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CalendarDayButton">
                <Border x:Name="Day" Background="{TemplateBinding Background}" CornerRadius="4" BorderBrush="Transparent" BorderThickness="1" Margin="1">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsToday" Value="True"><Setter TargetName="Day" Property="BorderBrush" Value="#E3BA61"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Day" Property="Background" Value="#245675"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Day" Property="Background" Value="#A8D8F2"/><Setter Property="Foreground" Value="#08223A"/></Trigger>
                    <Trigger Property="IsInactive" Value="True"><Setter Property="Foreground" Value="#8FA8C0"/></Trigger>
                    <Trigger Property="IsBlackedOut" Value="True"><Setter Property="Opacity" Value="0.35"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="HakedisCalendarMonth" TargetType="CalendarButton">
            <Setter Property="Foreground" Value="#F0F6FC"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="MinHeight" Value="45"/><Setter Property="MinWidth" Value="50"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CalendarButton"><Border x:Name="Month" Background="{TemplateBinding Background}" CornerRadius="4" Margin="2"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Month" Property="Background" Value="#245675"/></Trigger>
                <Trigger Property="HasSelectedDays" Value="True"><Setter TargetName="Month" Property="Background" Value="#A8D8F2"/><Setter Property="Foreground" Value="#08223A"/></Trigger>
                <Trigger Property="IsInactive" Value="True"><Setter Property="Opacity" Value="0.55"/></Trigger>
            </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="HakedisCalendarItem" TargetType="CalendarItem">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CalendarItem">
                <ControlTemplate.Resources>
                    <DataTemplate x:Key="{x:Static CalendarItem.DayTitleTemplateResourceKey}">
                        <TextBlock Text="{Binding}" Foreground="#B9CDDF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,5"/>
                    </DataTemplate>
                </ControlTemplate.Resources>
                <Border x:Name="PART_Root" Background="#09283F" BorderBrush="#5A7B94" BorderThickness="1" CornerRadius="7" Padding="8">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                            <Button x:Name="PART_PreviousButton" Content="‹" Padding="0" Focusable="False" ToolTip="Önceki"/>
                            <Button x:Name="PART_HeaderButton" Grid.Column="1" HorizontalContentAlignment="Center" Focusable="False"/>
                            <Button x:Name="PART_NextButton" Grid.Column="2" Content="›" Padding="0" Focusable="False" ToolTip="Sonraki"/>
                        </Grid>
                        <Grid x:Name="PART_MonthView" Grid.Row="1" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        </Grid>
                        <Grid x:Name="PART_YearView" Grid.Row="1" Visibility="Hidden" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        </Grid>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Calendar}}" Value="{x:Static CalendarMode.Year}"><Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden"/><Setter TargetName="PART_YearView" Property="Visibility" Value="Visible"/></DataTrigger>
                    <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Calendar}}" Value="{x:Static CalendarMode.Decade}"><Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden"/><Setter TargetName="PART_YearView" Property="Visibility" Value="Visible"/></DataTrigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="HakedisCalendar" TargetType="Calendar">
            <Setter Property="Background" Value="{StaticResource HakedisTableBrush}"/><Setter Property="Foreground" Value="{StaticResource HakedisTextBrush}"/>
            <Setter Property="CalendarItemStyle" Value="{StaticResource HakedisCalendarItem}"/>
            <Setter Property="CalendarDayButtonStyle" Value="{StaticResource HakedisCalendarDay}"/>
            <Setter Property="CalendarButtonStyle" Value="{StaticResource HakedisCalendarMonth}"/>
        </Style>
        <Style x:Key="HakedisDatePicker" TargetType="DatePicker">
            <Setter Property="CalendarStyle" Value="{StaticResource HakedisCalendar}"/>
            <Setter Property="Background" Value="{StaticResource HakedisInputBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource HakedisTextBrush}"/>
            <Setter Property="BorderBrush" Value="#5A7B94"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="37"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="7,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Border x:Name="Frame" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                            <DatePickerTextBox x:Name="PART_TextBox" Background="Transparent" Foreground="{TemplateBinding Foreground}" BorderThickness="0" Padding="7,0" VerticalContentAlignment="Center">
                                <DatePickerTextBox.Template>
                                    <ControlTemplate TargetType="DatePickerTextBox">
                                        <Grid Margin="{TemplateBinding Padding}">
                                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="DateHint" Text="__ / __ / ____" Foreground="#A9C2D4" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions><Condition Property="Text" Value=""/><Condition Property="IsKeyboardFocusWithin" Value="False"/></MultiTrigger.Conditions>
                                                <Setter TargetName="DateHint" Property="Visibility" Value="Visible"/>
                                            </MultiTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </DatePickerTextBox.Template>
                            </DatePickerTextBox>
                            <Button x:Name="PART_Button" Grid.Column="1" Focusable="False" ToolTip="Takvimi aç" Background="Transparent" BorderThickness="0" Padding="0" Height="Auto">
                                <Button.Template><ControlTemplate TargetType="Button"><Border Background="Transparent"><TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" Foreground="#C8E4F5" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/></Border></ControlTemplate></Button.Template>
                            </Button>
                            <Popup x:Name="PART_Popup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#A8D8F2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>


        
</ResourceDictionary>