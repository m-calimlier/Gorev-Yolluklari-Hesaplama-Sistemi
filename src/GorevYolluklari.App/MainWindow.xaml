<Window x:Class="GorevYolluklari.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Görev Yollukları Hesaplama Sistemi" Icon="Assets/RotaBelge.png" Width="1100" Height="730" MinWidth="800" MinHeight="560" Background="{StaticResource Navy}" Foreground="#F4F6FB" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" FontFamily="Segoe UI" FontSize="14" Language="tr-TR" WindowStartupLocation="CenterScreen">
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,16">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="Auto"/>
    <ColumnDefinition Width="*"/>
    <ColumnDefinition Width="Auto"/>
   </Grid.ColumnDefinitions>
   <Border Background="#123952" BorderBrush="#406685" BorderThickness="1" CornerRadius="12"
           Width="65" Height="65" Padding="7" VerticalAlignment="Center">
    <Image Source="Assets/RotaBelge.png" Stretch="Uniform"/>
   </Border>
   <StackPanel Grid.Column="1" Margin="15,0,10,0" VerticalAlignment="Center">
    <TextBlock Text="GÖREV YOLLUKLARI HESAPLAMA CETVELİ"
               Foreground="{StaticResource Gold}" FontWeight="Bold" FontSize="25"
               TextWrapping="Wrap" TextOptions.TextFormattingMode="Display"
               AutomationProperties.Name="Görev Yollukları Hesaplama Cetveli"/>
    <Border Background="{StaticResource Gold}" Height="3" Width="240"
            CornerRadius="2" Opacity="0.9" HorizontalAlignment="Left" Margin="0,7,0,0"/>
   </StackPanel>
   <Border Grid.Column="2" Background="#123952" BorderBrush="#406685"
           BorderThickness="1" CornerRadius="8" Padding="10,6" VerticalAlignment="Center">
    <StackPanel>
     <TextBlock Text="2026 · YURT İÇİ" Foreground="#E8C778" FontSize="11"
                FontWeight="SemiBold" HorizontalAlignment="Center"/>
     <TextBlock Text="HESAPLAMA" Foreground="#CFDCE8" FontSize="10"
                HorizontalAlignment="Center"/>
    </StackPanel>
   </Border>
  </Grid>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource WorkspaceCard}" Padding="0" Margin="0,0,14,0"><DockPanel Margin="8">
    <StackPanel DockPanel.Dock="Bottom" Margin="8,14,8,5">
     <TextBlock Text="Created by Murat ÇALIMLIER"
                Foreground="{StaticResource Gold}" FontWeight="Bold" FontSize="11"
                TextWrapping="Wrap" AutomationProperties.Name="Created by Murat ÇALIMLIER"/>
     <Border Height="1" Background="#35566F" Margin="0,9,0,9"/>
     <TextBlock Text="YOLLUK HESAPLAMA&#10;RESMÎ ONAY DEĞİLDİR"
                Foreground="#B5C9D9" FontSize="10" TextWrapping="Wrap"/>
    </StackPanel>
    <ListBox x:Name="Navigation" ItemContainerStyle="{StaticResource WorkspaceNavigationItem}"
      Background="Transparent" BorderThickness="0" Foreground="White"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
     <ListBox.ItemsPanel>
      <ItemsPanelTemplate><DockPanel LastChildFill="False"/></ItemsPanelTemplate>
     </ListBox.ItemsPanel>
    </ListBox></DockPanel></Border>
   <ScrollViewer x:Name="PageScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="2,0,10,0"><StackPanel x:Name="Page"/></ScrollViewer>
  </Grid>
  <Border Grid.Row="2" Style="{StaticResource HakedisStatusBanner}" Margin="0,12,0,0"><TextBlock x:Name="Status" Text="Veri girişi için görev türünü seçin." TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxHeight="88" Foreground="#C5D7E7" ToolTip="{Binding Text, ElementName=Status}"/></Border>
 </Grid>
</Window>
