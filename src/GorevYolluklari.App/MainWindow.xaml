<Window x:Class="GorevYolluklari.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Görev Yollukları Hesaplama Sistemi" Icon="Assets/RotaBelge.png" Width="1100" Height="730" MinWidth="800" MinHeight="560" Background="{StaticResource Navy}" Foreground="#F4F6FB" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" FontFamily="Segoe UI" FontSize="14" Language="tr-TR" WindowStartupLocation="CenterScreen">
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,16">
   <Image Source="Assets/RotaBelge.png" Width="52" Height="52" Margin="0,0,10,0" VerticalAlignment="Center"/>
   <StackPanel VerticalAlignment="Center">
    <TextBlock Text="Görev Yollukları" Foreground="{StaticResource Gold}" FontWeight="Bold" FontSize="12"/>
    <TextBlock Text="Hesaplama Sistemi" FontSize="25" FontWeight="SemiBold"/>
   </StackPanel>
   <TextBlock Text="2026 · Yurt içi · v0.8" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#B9C8DC"/>
  </DockPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource WorkspaceCard}" Padding="0" Margin="0,0,14,0"><DockPanel Margin="8"><TextBlock DockPanel.Dock="Bottom" Text="YOLLUK HESAPLAMA&#10;RESMÎ ONAY DEĞİLDİR" Foreground="{StaticResource Gold}" FontSize="11" Margin="8,14"/><ListBox x:Name="Navigation" ItemContainerStyle="{StaticResource WorkspaceNavigationItem}"
      Background="Transparent" BorderThickness="0" Foreground="White"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
     <ListBox.ItemsPanel>
      <ItemsPanelTemplate><DockPanel LastChildFill="False"/></ItemsPanelTemplate>
     </ListBox.ItemsPanel>
    </ListBox></DockPanel></Border>
   <ScrollViewer x:Name="PageScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="2,0,10,0"><StackPanel x:Name="Page"/></ScrollViewer>
  </Grid>
  <Border Grid.Row="2" Style="{StaticResource HakedisStatusBanner}" Margin="0,12,0,0"><TextBlock x:Name="Status" Text="Veri girişi için görev türünü seçin." TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxHeight="88" Foreground="#C5D7E7" ToolTip="{Binding Text, ElementName=Status}"/></Border>
 </Grid>
</Window>
