<Window x:Class="GorevYolluklari.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Görev Yollukları Hesaplama Sistemi" Width="1100" Height="730" MinWidth="800" MinHeight="560" Background="{StaticResource Navy}" Foreground="#F4F6FB" FontFamily="Segoe UI" FontSize="14" Language="tr-TR" WindowStartupLocation="CenterScreen">
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,16"><StackPanel><TextBlock Text="GÖREV YOLLUKLARI" Foreground="{StaticResource Gold}" FontWeight="Bold" FontSize="12"/><TextBlock Text="Hesaplama Sistemi" FontSize="25" FontWeight="SemiBold"/></StackPanel><TextBlock Text="2026 · Yurt içi · v0.8" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#B9C8DC"/></DockPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="{StaticResource Card}" CornerRadius="12" Margin="0,0,14,0"><DockPanel Margin="8"><TextBlock DockPanel.Dock="Bottom" Text="KONTROL TASLAĞI&#10;ÖDEME BELGESİ DEĞİLDİR" Foreground="{StaticResource Gold}" FontSize="11" Margin="8,14"/><ListBox x:Name="Navigation" Background="Transparent" BorderThickness="0" Foreground="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="8,13"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle></ListBox></DockPanel></Border>
   <ScrollViewer x:Name="PageScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="2,0,10,0"><StackPanel x:Name="Page"/></ScrollViewer>
  </Grid>
  <Border Grid.Row="2" Background="#243452" CornerRadius="8" Padding="12" Margin="0,12,0,0"><TextBlock x:Name="Status" Text="Personel ekleyerek başlayın. Örnek veri kendiliğinden yüklenmez." MaxHeight="88"/></Border>
 </Grid>
</Window>
